{
  "pythonVersion": "3.10",
  "typeCheckingMode": "strict",
  "include": ["version_checker", "tests"],
  "exclude": [
    "**/node_modules",
    "**/__pycache__",
    ".git",
    "build",
    "dist"
  ],
  "stubPath": "./typings",
  "reportMissingTypeStubs": "warning",
  "reportPrivateUsage": false
}
